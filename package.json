{
  "name": "@solera/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.14"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "files": [
    "src",
    "!src/**/*.stories.tsx"
  ],
  "scripts": {
    "dev": "storybook dev -p 6418 --no-open",
    "build": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src docs .storybook",
    "tokens": "node --experimental-strip-types scripts/tokens.mjs",
    "tokens:check": "node --experimental-strip-types scripts/tokens.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.3.0",
    "lucide-react": "^1.26.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10",
    "@storybook/react-vite": "^10",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.7"
  }
}
